# Copy to .env; change values for your deployment.
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION=eeg_rag_v1
RAG_SQLITE_PATH=./data/rag.sqlite3
RAG_UPLOAD_MAX_MB=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_BATCH_SIZE=16
# For real semantic retrieval install: uv sync --extra models
RAG_EMBEDDING_PROVIDER=bge
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_DEVICE=auto
# Optional: none / cross-encoder (requires --extra models)
RAG_RERANK_PROVIDER=none
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# vLLM OpenAI-compatible server (separate process)
RAG_LLM_BASE_URL=http://localhost:8000/v1
RAG_LLM_API_KEY=EMPTY
RAG_LLM_MODEL=/home/zzz/models/Qwen3-8B
RAG_LLM_MAX_TOKENS=768
RAG_LLM_TIMEOUT=120
RAG_CANDIDATE_K=30
# Optional API protection. Never expose the development server publicly without this.
RAG_API_KEY=
